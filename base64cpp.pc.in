prefix=@base64cpp_pc_prefix@
exec_prefix=${prefix}
libdir=@base64cpp_pc_LIBDIR@
includedir=@base64cpp_pc_INCLUDEDIR@

Name: base64cpp
Description: Dehancer base64 C++ encoder and decoder
Version: @PROJECT_VERSION@
URL: https://github.com/dehancer/base64cpp
Libs: -L${libdir} -lbase64cpp
Cflags: -I${includedir}
